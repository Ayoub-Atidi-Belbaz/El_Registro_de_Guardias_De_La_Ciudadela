<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F14"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="UT7: Persistencia en la Ciudadela"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnIrPrefs"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#6C5CE7"
        android:text="Laboratorio 1 Registro de Guardias"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnIrFicheros"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#00B894"
        android:text="Laboratorio 2 Pergaminos Internos"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnIrExterno"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#0984E3"
        android:text="Laboratorio 2 Mapas Externos"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnIrSQLite"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#2D3436"
        android:text="Laboratorio 3"
        android:textColor="#B2BEC3" />
</LinearLayout>